~ npc0_seller
if is_list_taken == true and is_groceries_bought == false:
	Penjual: Halo Donga! Mau ambil pesanan Chika ya?
	Donga: Iya Mang, ini daftar belanjanya.
	Penjual: Siap, ini beras, telur, sama sayurnya sudah dibungkus rapi.
	Donga: Terima kasih Mang!
	set is_groceries_bought = true
elif is_groceries_bought == true:
	Penjual: Semua belanjaanmu sudah lengkap. Hati-hati di jalan ya Donga!
else:
	Penjual: Buah dan sayur segar! Ayo dibeli sebelum kehabisan!
=> END

