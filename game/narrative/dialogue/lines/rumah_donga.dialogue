~ morning_part_6
do camera_controller.focus_on("Donga")
Donga: Btw, udah mau masak ya?.
do camera_controller.focus_on("Chika")
Chika: Iyaaa.
do camera_controller.reset_to_player()
=> END 


~ interact_chika
if is_list_taken == false:
	do camera_controller.focus_on("Chika")
	Chika: Ini daftar belanjanya. Jangan sampai ada yang kurang ya.
	do camera_controller.focus_on("Donga")
	Donga: Oke, aku berangkat sekarang.
	set is_list_taken = true
	do camera_controller.reset_to_player()
else:
	Chika: Hati-hati di jalan ya.
=> END

~ interact_orey
if is_list_taken == false:
	do camera_controller.focus_on("Chika")
	Orey: Hati-hati dijalan Pa.
	do camera_controller.focus_on("Donga")
	Donga: Siap, aku akan kembali dengan cepatj.
	set is_list_taken = true
	do camera_controller.reset_to_player()
else:
	Orey: Belum pergi Pa? Mama nungguin tuh.
=> END
